# ============================================================================
# Cockpit — Environment Variables
# ============================================================================
#
# Vercel (Deployment): Falls der Build nach routes-manifest.json in /public
# sucht: Dashboard → cockpit → Settings → General → Build & Output Settings
# → Framework: Next.js → Output Directory: leer (nicht „public“).
# Das Repo setzt framework/nextjs + outputDirectory null in vercel.json.
# ============================================================================
# Copy to .env locally (never commit secrets!).
# On Vercel: Project Settings → Environment Variables.
#
# All *_TOKEN / *_KEY values are secrets — never check them into git.
# ============================================================================

# --- GitHub (required) -------------------------------------------------------
GITHUB_TOKEN=                          # Personal Access Token (repo, read:org)
GITHUB_USER=                           # Your GitHub login
GITHUB_ORGS=                           # Comma-separated org logins to track
GITHUB_AUTHOR_LOGINS=                  # Optional: comma-separated GitHub author aliases to aggregate
GITHUB_AUTHOR_EMAILS=                  # Optional: comma-separated Git commit author emails to aggregate (server-side only)
GITHUB_REPO_OWNERS=                    # Optional: personal/user repo owners beyond GITHUB_USER
GITHUB_ZVV_ORGS=zvvch                  # Optional: orgs included by scope=zvv
GITHUB_SCOPE=all                       # all | private | organizations | zvv
GITHUB_HUMAN_AUTHORS=                  # Optional: logins for human/AI commit split

# --- Exposure / public-private split -----------------------------------------
COCKPIT_EXPOSURE_MODE=public           # public | private (private shows full internal operating view)
COCKPIT_PUBLIC_REDACT_OWNERS=zvvch,ALPA-one,besyncag,rlroomup,tmsimba
COCKPIT_CORS_ORIGIN=https://cockpit.rapold.io

# --- Lunar Velocity (optional overrides) -------------------------------------
LUNAR_GITHUB_TOKEN=                    # Optional separate PAT for /lunar
LUNAR_GITHUB_USER=marcel               # Default analyzed GitHub login
LUNAR_GITHUB_ORGS=                     # Optional org owners to include in /lunar
LUNAR_CACHE_DIR=.lunar-cache           # Local JSON cache for expensive analysis runs
NEXT_PUBLIC_LUNAR_VELOCITY_SUMMARY_URL= # Optional deployed /api/summary URL for the Cockpit Lunar card

# --- Vercel (optional — enables infra stats) ---------------------------------
VERCEL_API_KEY=                        # Vercel account token
VERCEL_TEAM_IDS=                       # Comma-separated Team IDs

# --- Supabase (optional — enables DB health) ---------------------------------
SUPABASE_ACCESS_TOKEN=                 # Management API token
# SUPABASE_PROJECTS=[{"id":"...","name":"..."}]  # Override auto-discovery

# --- Health checks (optional) ------------------------------------------------
# HEALTH_TARGETS=[{"name":"MyApp","url":"https://example.com"}]

# --- Redis (smart caching) ---------------------------------------------------
REDIS_URL=                             # redis:// connection string (set by Vercel Redis integration)
CRON_SECRET=                           # Secret for cron endpoint auth

# --- Public API v1 (optional — /api/v1/* auth) ------------------------------
API_TOKEN=                             # Bearer token for public API access
COCKPIT_PUBLIC_FALLBACK_ORIGIN=          # Optional public read fallback for local SSR; disabled by default

# --- Asset generation (scripts/generate-assets.mjs) --------------------------
APP_NAME=Cockpit
APP_DOMAIN=cockpit.rapold.io
APP_REPO_LABEL=marcelrapold/cockpit

# --- Local dependency scan (optional) ----------------------------------------
# SCAN_ROOT=/path/to/repos
